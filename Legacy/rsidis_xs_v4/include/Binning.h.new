#pragma once

#include <vector>
#include <TMath.h>

// Simple binning container for PlotCoinXsec.C
//  - pt in GeV
//  - z dimensionless
//  - phipq in radians, wrapped to [0, 2pi)
struct Binning {
  // pT bins (GeV)
  std::vector<double> ptEdges {0.0, 0.10, 0.20, 0.30, 0.40};

  // z bins
  std::vector<double> zEdges  {0.30, 0.40, 0.50, 0.60, 0.70};

  // phi_pq bins [0, 2pi]
  std::vector<double> phiEdges {
    0.0,
    1.0 * TMath::Pi() / 4.0,
    2.0 * TMath::Pi() / 4.0,
    3.0 * TMath::Pi() / 4.0,
    4.0 * TMath::Pi() / 4.0,
    5.0 * TMath::Pi() / 4.0,
    6.0 * TMath::Pi() / 4.0,
    7.0 * TMath::Pi() / 4.0,
    8.0 * TMath::Pi() / 4.0
  };
};
