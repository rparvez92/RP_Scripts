#!/usr/bin/env python3
"""
Plot fit parameters saved by rsidis_xs_v5 PlotCoinXsec.C.

This script is robust to a common formatting issue we've seen where
fit_parameters.csv is accidentally written as ONE long line with spaces
between rows (missing newlines). If detected, we auto-repair in-memory.

Usage (from rsidis_xs_v5/):
  python3 macros/plot_fit_parameters.py --group grp_...            # default locations
  python3 macros/plot_fit_parameters.py --group grp_... --min-prob 1e-4 --prefer-fine-pt
"""

from __future__ import annotations
import argparse
import io
import math
import re
from pathlib import Path

import numpy as np
import pandas as pd

# Force non-interactive backend (avoids EGL/GL warnings on some nodes)
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt


def repair_fit_csv_text(raw: str) -> str:
    """
    If the file contains no newlines (or only header newline got lost),
    insert newlines before each record starting with 'group,' or 'single,'.

    We do this conservatively: only if the text appears to be one long line.
    """
    # Normalize CRLF
    raw = raw.replace("\r\n", "\n").replace("\r", "\n")
    if raw.count("\n") >= 2:
        return raw

    # Insert newline before tokens "group," or "single," when preceded by whitespace
    # Example: "... ,prob group,grp_..." -> "... ,prob\ngroup,grp_..."
    fixed = re.sub(r"\s+(group|single),", r"\n\1,", raw.strip())

    # Sometimes there may be multiple spaces or tabs between rows; ensure clean
    # Remove trailing spaces on lines
    fixed = "\n".join([ln.strip() for ln in fixed.split("\n") if ln.strip() != ""])
    return fixed + "\n"


def load_fit_parameters(csv_path: Path) -> pd.DataFrame:
    raw = csv_path.read_text()
    repaired = repair_fit_csv_text(raw)

    # Now parse
    df = pd.read_csv(io.StringIO(repaired))

    # Basic cleanup / types
    # Some columns might come in as object; coerce safely
    numeric_cols = [
        "pt_bin","pt_lo","pt_hi","pt_center",
        "z_center","M0","M0_err","A","A_err","B","B_err","C","C_err",
        "chi2","ndf","prob"
    ]
    for c in numeric_cols:
        if c in df.columns:
            df[c] = pd.to_numeric(df[c], errors="coerce")

    # Strip labels
    for c in ["group_id", "curve_label", "mode"]:
        if c in df.columns:
            df[c] = df[c].astype(str).str.strip()

    return df


def choose_pt_scheme(df: pd.DataFrame, prefer_fine_pt: bool) -> pd.DataFrame:
    """
    The file can contain both:
      - wide-pt overlay fits (pt_lo=0, pt_hi=0.4, pt_bin=0)
      - 4-pt-bin fits (pt_hi=0.1,0.2,0.3,0.4; pt_bin=0..3)

    If prefer_fine_pt is True and we detect multiple pt_bin values, keep only fine scheme.
    """
    if not prefer_fine_pt:
        return df

    # If any curve has more than 1 unique pt_bin, we assume fine scheme exists.
    n_ptbins = df.groupby("curve_label")["pt_bin"].nunique(dropna=True)
    if (n_ptbins > 1).any():
        # Keep rows with pt_bin in {0,1,2,3} AND (pt_hi <= 0.4000001) but exclude the wide-only duplicate:
        # Wide-only duplicate is pt_bin==0 and pt_lo==0 and pt_hi==0.4 while fine bin 0 has pt_hi==0.1.
        mask_wide_duplicate = (df["pt_bin"] == 0) & (np.isclose(df["pt_lo"], 0.0)) & (np.isclose(df["pt_hi"], 0.4))
        return df.loc[~mask_wide_duplicate].copy()

    return df


def filter_reasonable(df: pd.DataFrame, min_prob: float, max_rel_err: float) -> pd.DataFrame:
    """
    Remove fits that are clearly broken (NaNs, infinities, crazy relative errors).
    We keep this gentle: if you want everything, set min_prob=0 and max_rel_err very large.
    """
    d = df.copy()

    # Drop NaNs in the main fit outputs we want to plot
    for col in ["pt_center","z_center","M0","A","B","C","prob"]:
        if col in d.columns:
            d = d.loc[np.isfinite(d[col])]

    # Prob filter (optional)
    if min_prob > 0:
        d = d.loc[d["prob"] >= min_prob]

    # Relative error filter (optional)
    def relerr(val, err):
        return np.abs(err) / np.maximum(np.abs(val), 1e-12)

    for p, pe in [("M0","M0_err"), ("A","A_err"), ("B","B_err"), ("C","C_err")]:
        if p in d.columns and pe in d.columns:
            rr = relerr(d[p].to_numpy(), d[pe].to_numpy())
            d = d.loc[rr <= max_rel_err]

    return d


def _style_ax(ax, xlabel, ylabel, title):
    ax.set_xlabel(xlabel)
    ax.set_ylabel(ylabel)
    ax.set_title(title)
    ax.grid(True, alpha=0.3)


def plot_param_vs_pt(df: pd.DataFrame, param: str, err: str, outpath: Path):
    plt.figure()
    ax = plt.gca()

    for lab, d in df.groupby("curve_label"):
        d = d.sort_values("pt_center")
        ax.errorbar(d["pt_center"], d[param], yerr=d[err], fmt="o-", capsize=2, label=str(lab))

    _style_ax(ax, r"$p_T$ (GeV)", param, f"Fit parameter {param} vs $p_T$")
    ax.legend(frameon=False)
    outpath.parent.mkdir(parents=True, exist_ok=True)
    plt.tight_layout()
    plt.savefig(outpath, dpi=200)
    plt.close()


def plot_param_vs_z_grid(df: pd.DataFrame, param: str, err: str, outpath: Path):
    # Determine pt bins present
    pt_bins = sorted([x for x in df["pt_bin"].dropna().unique()])
    if len(pt_bins) == 0:
        return

    n = len(pt_bins)
    ncols = 2
    nrows = int(math.ceil(n / ncols))
    fig, axes = plt.subplots(nrows=nrows, ncols=ncols, figsize=(10, 4.5*nrows))
    axes = np.atleast_1d(axes).reshape(nrows, ncols)

    for i, pb in enumerate(pt_bins):
        r = i // ncols
        c = i % ncols
        ax = axes[r, c]
        dpt = df.loc[df["pt_bin"] == pb].copy()

        for lab, d in dpt.groupby("curve_label"):
            d = d.sort_values("z_center")
            ax.errorbar(d["z_center"], d[param], yerr=d[err], fmt="o-", capsize=2, label=str(lab))

        # Title with pt range (use first row values)
        ptlo = dpt["pt_lo"].dropna().iloc[0] if dpt["pt_lo"].notna().any() else np.nan
        pthi = dpt["pt_hi"].dropna().iloc[0] if dpt["pt_hi"].notna().any() else np.nan
        ax.set_title(rf"$p_T \in [{ptlo:.2f}, {pthi:.2f}]$ GeV")
        _style_ax(ax, "z", param, "")

        ax.legend(frameon=False)

    # Turn off unused axes
    for j in range(n, nrows*ncols):
        r = j // ncols
        c = j % ncols
        axes[r, c].axis("off")

    fig.suptitle(f"{param} vs z (pads: $p_T$ bins)", y=0.98)
    outpath.parent.mkdir(parents=True, exist_ok=True)
    plt.tight_layout(rect=[0, 0, 1, 0.97])
    plt.savefig(outpath, dpi=200)
    plt.close(fig)


def plot_prob_vs_pt(df: pd.DataFrame, outpath: Path):
    plt.figure()
    ax = plt.gca()

    for lab, d in df.groupby("curve_label"):
        d = d.sort_values("pt_center")
        ax.plot(d["pt_center"], d["prob"], marker="o", label=str(lab))

    ax.set_yscale("log")
    _style_ax(ax, r"$p_T$ (GeV)", "Fit probability", "Fit quality: probability vs $p_T$")
    ax.legend(frameon=False)
    outpath.parent.mkdir(parents=True, exist_ok=True)
    plt.tight_layout()
    plt.savefig(outpath, dpi=200)
    plt.close()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--group", required=True, help="Group directory name, e.g. grp_LH2_zOv_x0p25_Q23p3_tpq2p0")
    ap.add_argument("--base", default="results", help="Results base directory (default: results)")
    ap.add_argument("--min-prob", type=float, default=0.0, help="Drop fits with prob < this (default: 0)")
    ap.add_argument("--max-rel-err", type=float, default=1e6, help="Drop fits with relative error > this (default: huge)")
    ap.add_argument("--prefer-fine-pt", action="store_true",
                    help="If both wide-pt and 4-pt-bin fits exist, keep the 4-bin scheme")
    args = ap.parse_args()

    base = Path(args.base)
    csv_path = base / args.group / "tables" / "fit_parameters.csv"
    if not csv_path.exists():
        raise FileNotFoundError(f"Missing {csv_path}")

    df = load_fit_parameters(csv_path)

    # Optional selection
    df = df.loc[df["group_id"] == args.group].copy() if "group_id" in df.columns else df
    df = choose_pt_scheme(df, args.prefer_fine_pt)
    df = filter_reasonable(df, min_prob=args.min_prob, max_rel_err=args.max_rel_err)

    outdir = base / args.group / "PNGs" / "fitparam_plots"
    outdir.mkdir(parents=True, exist_ok=True)

    # Core plots requested
    plot_param_vs_pt(df, "A", "A_err", outdir / "A_vs_pT.png")
    plot_param_vs_pt(df, "B", "B_err", outdir / "B_vs_pT.png")
    plot_param_vs_pt(df, "C", "C_err", outdir / "C_vs_pT.png")
    plot_param_vs_pt(df, "M0", "M0_err", outdir / "M0_vs_pT.png")
    plot_prob_vs_pt(df, outdir / "prob_vs_pT.png")

    # Optional "vs z grid" versions (pads = pt bins)
    plot_param_vs_z_grid(df, "A", "A_err", outdir / "A_vs_z_grid.png")
    plot_param_vs_z_grid(df, "B", "B_err", outdir / "B_vs_z_grid.png")
    plot_param_vs_z_grid(df, "C", "C_err", outdir / "C_vs_z_grid.png")
    plot_param_vs_z_grid(df, "M0", "M0_err", outdir / "M0_vs_z_grid.png")

    print(f"Wrote plots to: {outdir}")


if __name__ == "__main__":
    main()
